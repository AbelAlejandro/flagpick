#!/usr/bin/expect -f

set timeout 10
set env(TERM) xterm-256color
log_user 0

proc assert_exit {expected label} {
    expect eof
    set result [wait]
    set actual [lindex $result 3]
    if {$actual != $expected} {
        puts stderr "$label: expected exit $expected, got $actual"
        exit 1
    }
}

spawn sh -c {printf tests/fixtures/discovery-help.sh | ./target/debug/flagpick shell-edit zsh --cursor 32}
after 200
send "\r"
expect {
    "tests/fixtures/discovery-help.sh --help" {}
    timeout {
        puts stderr "confirm: edited command did not appear"
        exit 1
    }
}
assert_exit 0 "confirm"

spawn sh -c {printf tests/fixtures/discovery-help.sh | ./target/debug/flagpick shell-edit zsh --cursor 2 --at-cursor}
after 200
send "\r"
expect {
    "te--helpsts/fixtures/discovery-help.sh" {}
    timeout {
        puts stderr "at-cursor: edited command did not appear"
        exit 1
    }
}
assert_exit 0 "at-cursor"

spawn sh -c {printf tests/fixtures/discovery-help.sh | ./target/debug/flagpick shell-edit zsh --cursor 32}
after 200
send "\033\[B"
after 20
send "\r"
expect {
    "tests/fixtures/discovery-help.sh --verbose" {}
    timeout {
        puts stderr "navigation: second option was not inserted"
        exit 1
    }
}
assert_exit 0 "navigation"

spawn sh -c {printf tests/fixtures/discovery-help.sh | ./target/debug/flagpick shell-edit zsh --cursor 32}
after 200
send "zzzz\r"
assert_exit 1 "empty search confirmation"

spawn sh -c {printf tests/fixtures/discovery-help.sh | ./target/debug/flagpick shell-edit zsh --cursor 32}
after 200
send "\033"
assert_exit 130 "cancel"

puts "TUI pseudo-terminal checks passed"
